package com.aula05;

public class Fila {
    private int frente, tras, tamanho;
    private int capacidade;
    private int[] elementos;

    public Fila(int capacidade) {
        this.capacidade = capacidade;
        elementos = new int[capacidade];
        frente = 0;
        tras = -1;
        tamanho = 0;
    }

    // Método para adicionar um elemento à fila
    public void enqueue(int elemento) {
        if (tamanho == capacidade) {
            System.out.println("Fila Cheia!");
            return;
        }
        tras = (tras + 1) % capacidade;  // Circular increment
        elementos[tras] = elemento;
        tamanho++;
    }

    // Método para remover um elemento da fila
    public int dequeue() {
        if (tamanho == 0) {
            System.out.println("A Fila está vazia!");
            return -1; // Retorna -1 caso a fila esteja vazia
        }
        int removido = elementos[frente];
        frente = (frente + 1) % capacidade; // Circular increment
        tamanho--;
        return removido;
    }

    // Método para verificar se a fila está vazia
    public boolean isEmpty() {
        return tamanho == 0;
    }

    // Método para exibir os elementos da fila
    public void exibir() {
        for (int i = 0; i < tamanho; i++) {
            System.out.println(elementos[(frente + i) % capacidade]);  // Acesso circular aos elementos
        }
    }

    // Método para olhar o elemento da frente da fila (sem removê-lo)
    public int peek() {
        if (tamanho == 0) {
            System.out.println("A Fila está vazia!");
            return -1; // Retorna -1 caso a fila esteja vazia
        }
        return elementos[frente];  // Retorna o elemento da frente da fila
    }

    public static void main(String[] args) {
        Fila fila = new Fila(5); 
        
        fila.enqueue(10); // Inicializa com o valor 10
        fila.enqueue(20);
        fila.enqueue(30);
        
       // System.out.println("Elementos na fila:");
        fila.exibir(); // Exibe os elementos da fila
       //System.out.println("Elemento da frente (peek): " + fila.peek()); // Verifica o elemento da frente       
       // System.out.println("Removido da fila: " + fila.dequeue()); // Remove um elemento
        fila.dequeue();
       // System.out.println("Elementos após remoção:");
        fila.exibir(); // Exibe novamente os elementos da fila após a remoção
    }
} 
      
